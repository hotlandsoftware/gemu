# Auto-generated by ./configure --build-dir=build/all --bindir=bin
# Do not edit - re-run ./configure to update.

ninja_required_version = 1.3

CC          = gcc
CFLAGS_BASE = -Wall -Wextra -O3 -flto -std=gnu11 -pthread

# Compile a C file; deps tracked via GCC depfile.
rule cc
  command = $CC $CFLAGS -MD -MF $out.d -c -o $out $in
  depfile = $out.d
  deps    = gcc
  description = CC $in

# Link object files into a binary.
rule link
  command = $CC -o $out $in $LDFLAGS
  description = LINK $out

# Regenerate build.ninja when configure changes.
rule reconfigure
  command = python3 configure --build-dir=build/all --bindir=bin
  generator = 1
  description = RECONFIGURE

