  CFLAGS = $CFLAGS_BASE -Icore/include -Icpu -Ivga -Iaudio -Ihardware -Ihardware/machine -Ihardware/device -Isrc -Ibuild -I/usr/include/SDL2 -D_GNU_SOURCE=1 -D_REENTRANT -I/usr/include/lua5.1 -I/usr/include/SDL2 -D_GNU_SOURCE=1 -D_REENTRANT -I/usr/include/libpng16 -DHWY_SHARED_DEFINE -DAVIF_DLL -I/usr/include/rav1e -I/usr/include/svt-av1 -DEB_DLL -DRTC_BUILD=0 -I/usr/include/webp -DHAVE_CHIP8 -DHAVE_MOS -DHAVE_RCA -DHAVE_TTF -DHAVE_ALSA -DHAVE_ROB -DHAVE_CACA -DHAVE_LUA -DHAVE_SDL_IMAGE -DHAVE_LIBZIP -DHAVE_CRYPTO

