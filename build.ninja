  CFLAGS = $CFLAGS_BASE -Icore/include -Icore/third_party/cjson -Icpu -Ivga -Iaudio -Icrt -Ihardware -Ihardware/machine -Ihardware/device -Iwindow -Ihardware/chip8 -Ihardware/ia64 -Ihardware/mos -Ihardware/other -Ihardware/rca -Ihardware/x86 -Ihardware/z80 -Ihardware/machine/chip8 -Ihardware/machine/ia64 -Ihardware/machine/mos -Ihardware/machine/other -Ihardware/machine/rca -Ihardware/machine/x86 -Ihardware/machine/z80 -Ivga/ia64 -Ivga/mos -Ivga/rca -Ivga/multi -Ivga/x86 -Icpu/chip8 -Icpu/ia64 -Icpu/mos -Icpu/rca -Icpu/x86 -Icpu/z80 -Isrc -Ibuild/all -I/usr/include/SDL2 -D_GNU_SOURCE=1 -D_REENTRANT -I/usr/include/lua5.1 -I/usr/include/SDL2 -D_GNU_SOURCE=1 -D_REENTRANT -I/usr/include/libpng16 -DHWY_SHARED_DEFINE -DAVIF_DLL -I/usr/include/rav1e -I/usr/include/svt-av1 -DEB_DLL -DRTC_BUILD=0 -I/usr/include/webp -DHAVE_CHIP8 -DHAVE_IA64 -DHAVE_MITSU -DHAVE_MOS -DHAVE_RCA -DHAVE_X86 -DHAVE_Z80 -DHAVE_TTF -DHAVE_ALSA -DHAVE_ROB -DHAVE_CACA -DHAVE_LUA -DHAVE_SDL_IMAGE -DHAVE_LIBZIP -DHAVE_CRYPTO -Icpu/x86 -Icore/third_party/cjson
