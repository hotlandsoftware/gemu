<?xml version="1.0"?>
<!-- Explicit "always cheap" name: unlike -device crt (see crt.xml), this
     one won't be upgraded if a nicer decode mode is added later; it
     stays pinned to MOS_CRT_CHEAP for users who specifically want the
     budget-TV look (visible dot crawl/chroma fringing from a single-line
     decode with no comb filter) rather than whatever the best available
     quality happens to be. -->
<device name="cheap-crt" description="Generic, cheap CRT monitor (single-line NTSC decode, no comb filter dot crawl/chroma bleed" status="preliminary">
    <machine name="nes"/>
    <machine name="famicom"/>
    <machine name="vssmb"/>
    <machine name="vsskatekids"/>
</device>
