<?xml version="1.0"?>
<!-- Generic name: always the best available CRT pipeline. Currently this is
     NES composite encode -> 3-line chroma comb decode -> generic tube pass.
     Less dot crawl/fringing than -device cheap-crt (see cheap-crt.xml),
     which stays pinned to the plain single-line decode path on purpose
     rather than upgrading alongside this name. -->
<device name="crt" description="Generic CRT monitor" status="preliminary">
    <machine name="nes"/>
    <machine name="famicom"/>
    <machine name="vssmb"/>
    <machine name="vsskatekids"/>
</device>
