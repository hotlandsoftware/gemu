    dict(name='fiveclown_core', family='mos', kind='program', src='tests/fiveclown_core.c',
         replaces=['hardware/machine/mos/machine_5clown.c']),
    dict(name='magicfly_core', family='mos', kind='program', src='tests/magicfly_core.c',
         replaces=['hardware/machine/mos/machine_magicfly.c']),
    dict(name='um6578_core', family='mos', kind='program', src='tests/um6578_core.c',
         replaces=['hardware/machine/mos/machine_um6578.c']),
]

# ── Helpers ────────────────────────────────────────────────────────────────────

def run(cmd):
    try:
        return subprocess.check_output(cmd, stderr=subprocess.DEVNULL, text=True).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None

PKG_CONFIG = 'pkg-config'   # --cross may point it at the target's libraries

def pkg(package, *flags):
    r = run([PKG_CONFIG] + list(flags) + [package])
    return r.split() if r is not None else None

def check(label, result):
    print(f'  checking {label}... {"yes" if result else "no"}')
    return result

def die(msg):
    print(f'configure: error: {msg}', file=sys.stderr)
    sys.exit(1)

# ── Data-file generation ───────────────────────────────────────────────────────

FAMILY_SETUP  = {'mos': 'mos_setup', 'rca': 'rca_setup', 'chip8': 'chip8_setup', 'mitsu': 'mitsu_setup', 'other': 'other_setup', 'ia64': 'ia64_setup', 'x86': 'x86_setup', 'z80': 'z80_setup'}
FAMILY_DEFINE = {'mos': 'HAVE_MOS',  'rca': 'HAVE_RCA',  'chip8': 'HAVE_CHIP8', 'mitsu': 'HAVE_MITSU', 'other': 'HAVE_OTHER',  'ia64': 'HAVE_IA64',  'x86': 'HAVE_X86', 'z80': 'HAVE_Z80'}

def _xml_files(*patterns):
    paths = []
    for pat in patterns:
        paths.extend(sorted(glob.glob(pat, recursive=True)))
    return paths

# Ranks mirror MAME driver status flags; see MACHINES_MOS.md's "Implemented"
# table for the vocabulary this predates and should eventually replace.
# Shared by machine/device/soundhw/chargen/vga XMLs.
STATUSES = {'working', 'imperfect', 'preliminary', 'skeleton'}

def _status(path, root):
    status = root.get('status', '')
    if status and status not in STATUSES:
        die(f"{path}: invalid status '{status}' "
            f"(expected one of: {', '.join(sorted(STATUSES))})")
    return status

def _with_status(desc, status):
    return f'{desc} [{status}]' if status else desc

# Device type registry (core/src/dev/device.c): a <type symbol="..."
# source="..."/> element in a data/device XML says which C symbol is the
# GemuDeviceType of that device and which source defines it.  Each binary's
# table lists the types whose source it links, so a device test gets just
# the types it links.  Tests may add their own XML (tests/data/device/).
DEVICE_TYPE_XML = ['data/device/**/*.xml']
TEST_DEVICE_TYPE_XML = ['tests/data/device/*.xml']

def device_types(patterns):
    """[(name, symbol, source)] from the <type> elements, sorted by name."""
    types, seen = [], {}
    for path in _xml_files(*patterns):
        root = ET.parse(path).getroot()
        for t in root.findall('type'):
            name, sym, src = root.get('name'), t.get('symbol'), t.get('source')
            if not name or not sym or not src:
                die(f'{path}: <type> needs symbol= and source=, and the <device> a name=')
            if not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', sym):
                die(f'{path}: type symbol "{sym}" is not a C identifier')
            if not os.path.exists(src):
                die(f'{path}: type source {src} not found')
            if name in seen:
                die(f'{path}: device type "{name}" is also in {seen[name]}')
            seen[name] = path
            types.append((name, sym, src))
    types.sort(key=lambda t: t[0].encode())   # strcmp order, for bsearch
    return types

def write_device_types(out_path, types, linked):
    """Write the registry .c for a binary that links the sources `linked`."""
    use = [t for t in types if t[2] in linked]
    lines = ['// Auto-generated by configure from <type> elements in data/device XML\n',
             '// - do not edit\n',
             '#include "gemu/dev/registry.h"\n\n']
    for name, sym, src in use:
        lines.append(f'extern const GemuDeviceType {sym};   /* {src} */\n')
    lines.append('\nconst GemuDeviceTypeEntry gemu_device_type_table[] = {\n')
    for name, sym, src in use:
        lines.append(f'    {{ "{name}", &{sym} }},\n')
    lines.append('    { 0, 0 }\n};\n')
    text = ''.join(lines)
    os.makedirs(os.path.dirname(out_path), exist_ok=True)
    # unchanged content keeps its timestamp, so ninja doesn't rebuild it
    if os.path.exists(out_path) and open(out_path, encoding='utf-8').read() == text:
        return
    with open(out_path, 'w', encoding='utf-8') as f:
        f.write(text)

def generate_data(build_dir, targets, have_alsa, have_winmidi=False):
    gen_dir = os.path.join(build_dir, 'generated')
    os.makedirs(gen_dir, exist_ok=True)

    active = set(targets)

    # ── Parse machine XMLs ────────────────────────────────────────────────────
    machines = []
    machine_family = {}
    for path in _xml_files('data/machine/**/*.xml'):
        root = ET.parse(path).getroot()
        name   = root.get('name')
        family = root.get('family')
        desc   = root.get('description', '')
        menu   = root.get('menu', '')
        if menu and menu != 'disabled':
            die(f"{path}: invalid menu '{menu}' (expected 'disabled')")
        roms   = [{'name': r.get('name'), 'region': r.get('region', ''),
                   'addr': int(r.get('addr', '0'), 16),
                   'sha256': r.get('sha256', '')}
                  for r in root.findall('rom')]
        devices = [d.get('name') for d in root.findall('device') if d.get('name')]
        status = _status(path, root)
        machines.append({
            'name':   name,
            'family': family,
            'desc':   desc,
            'roms':   roms,
            'alias':  root.get('alias',  ''),
            'cpu':    root.get('cpu',    ''),
            'vga':    root.get('vga',    ''),
            'soundhw': root.get('soundhw', ''),
            'chargen': root.get('chargen', ''),
            'tv':     root.get('tv',     ''),
            'ram':    root.get('ram',    ''),
            'devices': ','.join(devices),
            'menu':   menu,
            'status': status,
        })
        machine_family[name] = family
    machines.sort(key=lambda m: m['name'])

    # Resolve alias inheritance: aliases inherit cpu/vga/soundhw/chargen from their canonical
    # (but not tv - that is machine-specific) and fill in canonical name.
    name_to_m = {m['name']: m for m in machines}
    for m in machines:
        if m['alias']:
            canon = name_to_m.get(m['alias'], {})
            if not m['cpu'] and canon.get('cpu'): m['cpu'] = canon['cpu']
            if not m['vga'] and canon.get('vga'): m['vga'] = canon['vga']
            if not m['soundhw'] and canon.get('soundhw'): m['soundhw'] = canon['soundhw']
            if not m['chargen'] and canon.get('chargen'): m['chargen'] = canon['chargen']
            m['canonical'] = m['alias']
        else:
            m['canonical'] = m['name']

    # machines.inc - filtered to active families, no #ifdef needed
    lines = ['// Auto-generated from data/machine/*.xml - do not edit\n']
    for m in machines:
        if m['family'] not in active:
            continue
        setup = FAMILY_SETUP.get(m['family'], m['family'] + '_setup')
        desc = _with_status(m['desc'], m['status'])
        lines.append(f'    {{ "{m["name"]}", {setup}, "{desc}" }},\n')
    with open(os.path.join(gen_dir, 'machines.inc'), 'w', encoding='utf-8') as f:
        f.writelines(lines)

    # manager_machines.inc - what the GTK Machine Manager shows and offers per
    # machine: name, family, description, status, alias, the long
    # <description> text, default devices, cpu, ram (default, min, max: a
    # ram-max makes the size settable), sound hardware, chipset and media.
    # media="slot[:device],..." lists the drives the machine takes (slots
    # are the manager's: cartridge, tape, fda, fdb, hda, hdb, cdrom, rom,
    # cpm, program); ":device" is the -device the drive needs.  An alias
    # without its own media/ram-min/ram-max/chipset/<feature>s has its
    # canonical machine's.
    #
    # manager_features.inc - the -M NAME,OPTS feature switches: <feature
    # name= description= [values="a,b"]/>.  Without values it is on/off,
    # on by default, and off is passed as "-NAME"; with values the choice
    # is passed as NAME=VALUE (left out: the machine works it out).
    def cesc(s):
        return (s.replace('\\', '\\\\').replace('"', '\\"')
                 .replace('\r', '').replace('\n', '\\n'))
    mgr = {}
    for path in _xml_files('data/machine/**/*.xml'):
        root = ET.parse(path).getroot()
        el = root.find('description')
        text = el.get('description', '') if el is not None else ''
        mgr[root.get('name')] = {
            'long':     ' '.join(text.split()),
            'media':    root.get('media'),
            'ram-min':  root.get('ram-min'),
            'ram-max':  root.get('ram-max'),
            'chipset':  root.get('chipset'),
            'features': [(f.get('name', ''), f.get('description', ''), f.get('values', ''))
                         for f in root.findall('feature')],
        }
    def mgr_get(m, key, default=''):
        own = mgr.get(m['name'], {}).get(key)
        if own is None and m['alias']:
            own = mgr.get(m['alias'], {}).get(key)
        return default if own is None else own
    mlines = ['// Auto-generated from data/machine/*.xml - do not edit\n']
    flines = ['// Auto-generated from data/machine/*.xml - do not edit\n']
    for m in machines:
        if m['family'] not in active:
            continue
        ram = m['ram'] or (name_to_m.get(m['alias'], {}).get('ram', '') if m['alias'] else '')
        mlines.append(
            f'    {{ "{cesc(m["name"])}", "{m["family"]}", "{cesc(m["desc"])}", '
            f'"{m["status"]}", "{m["alias"]}", "{cesc(mgr.get(m["name"], {}).get("long", ""))}", '
            f'"{m["devices"]}", "{m["cpu"]}", "{ram}", "{mgr_get(m, "ram-min")}", '
            f'"{mgr_get(m, "ram-max")}", "{m["soundhw"]}", "{cesc(mgr_get(m, "chipset"))}", '
            f'"{mgr_get(m, "media")}" }},\n')
        feats = mgr.get(m['name'], {}).get('features') or \
                (mgr.get(m['alias'], {}).get('features', []) if m['alias'] else [])
        for fname, fdesc, fvalues in feats:
            flines.append(f'    {{ "{m["name"]}", "{cesc(fname)}", "{cesc(fdesc)}", "{cesc(fvalues)}" }},\n')
    with open(os.path.join(gen_dir, 'manager_machines.inc'), 'w', encoding='utf-8') as f:
        f.writelines(mlines)
    with open(os.path.join(gen_dir, 'manager_features.inc'), 'w', encoding='utf-8') as f:
        f.writelines(flines)

    # machines_<family>.inc - GemuDevDesc {name, desc} rows for each family's
    # -M validation/listing table (keeps setup .c files free of hand-copied
    # machine descriptions).
    fam_lines = {fam: ['// Auto-generated from data/machine/*.xml - do not edit\n']
                 for fam in active}
    for m in machines:
        if m['family'] not in active:
            continue
        desc = _with_status(m['desc'], m['status']).replace('"', '\\"')
        fam_lines[m['family']].append(f'    {{ "{m["name"]}", "{desc}" }},\n')
    for fam, flines in fam_lines.items():
        with open(os.path.join(gen_dir, f'machines_{fam}.inc'), 'w', encoding='utf-8') as f:
            f.writelines(flines)

    # machine_defaults.inc - per-machine defaults table used by *_setup.c
    def cstr(s): return f'"{s}"' if s else 'NULL'
    dlines = ['// Auto-generated from data/machine/*.xml - do not edit\n']
    for m in machines:
        if m['family'] not in active:
            continue
        tv = m['tv'] or ('pal' if m.get('alias') and name_to_m.get(m['alias'], {}).get('tv') == 'pal' else 'ntsc')
        dlines.append(
            f'    {{ "{m["name"]}", "{m["canonical"]}", '
            f'{cstr(m["cpu"])}, {cstr(m["vga"])}, '
            f'{cstr(m["soundhw"])}, {cstr(m["chargen"])}, '
            f'"{tv}", {cstr(m["ram"])}, {cstr(m["devices"])}, '
            f'{cstr(m["menu"])} }},\n'
        )
    with open(os.path.join(gen_dir, 'machine_defaults.inc'), 'w', encoding='utf-8') as f:
        f.writelines(dlines)

    # romdb.inc - all families combined; romdb.c is family-agnostic
    romdb_lines = ['// Auto-generated from data/machine/*.xml - do not edit\n']
    for m in machines:
        for r in m['roms']:
            if not r['sha256']:
                continue
            romdb_lines.append(
                f'    {{ "{r["sha256"]}", 0x{r["addr"]:04X}u, '
                f'{cstr(r["region"])}, "{m["name"]}", "{r["name"]}" }},\n'
            )
    with open(os.path.join(gen_dir, 'romdb.inc'), 'w', encoding='utf-8') as f:
        f.writelines(romdb_lines)

    # ── Parse device XMLs ─────────────────────────────────────────────────────
    devices = []
    for path in _xml_files('data/device/**/*.xml'):
        root = ET.parse(path).getroot()
        name  = root.get('name')
        desc  = root.get('description', '')
        status = _status(path, root)
        if root.get('scope') == 'all':
            mlist = sorted(mn for mn, fam in machine_family.items() if fam in active)
        else:
            mlist = [m.get('name') for m in root.findall('machine')]
            mlist = [mn for mn in mlist if machine_family.get(mn, '') in active]
        if not mlist:
            continue
        devices.append({'name': name, 'desc': desc, 'machines': mlist, 'status': status})
    devices.sort(key=lambda d: d['name'])

    lines = ['// Auto-generated from data/device/**/*.xml - do not edit\n']
    for d in devices:
        desc = _with_status(d['desc'], d['status']).replace('"', '\\"')
        mstr = ', '.join(d['machines'])
        lines.append(f'    {{ "{d["name"]}", "{desc}", "{mstr}" }},\n')
    with open(os.path.join(gen_dir, 'devices.inc'), 'w', encoding='utf-8') as f:
        f.writelines(lines)

    # manager_devices.inc - each device's category, the data/device folder it
    # is in (input, display, data, network, other), for the Machine Manager.
    lines = ['// Auto-generated from data/device/**/*.xml - do not edit\n']
    for path in _xml_files('data/device/**/*.xml'):
        cat = os.path.basename(os.path.dirname(path))
        name = ET.parse(path).getroot().get('name')
        if any(d['name'] == name for d in devices):
            lines.append(f'    {{ "{name}", "{cat}" }},\n')
    with open(os.path.join(gen_dir, 'manager_devices.inc'), 'w', encoding='utf-8') as f:
        f.writelines(lines)

    # ── Parse soundhw XMLs ────────────────────────────────────────────────────
    soundhw = []
    for path in _xml_files('data/soundhw/*.xml'):
        root = ET.parse(path).getroot()
        name   = root.get('name')
        desc   = root.get('description', '')
        req    = root.get('requires', '')
        req_ft = root.get('requires-feature', '')
        status = _status(path, root)
        mlist  = [m.get('name') for m in root.findall('machine')]
        if req and req not in active:
            continue
        if req_ft == 'alsa'  and not have_alsa:    continue
        if req_ft == 'midi'  and not (have_alsa or have_winmidi): continue
        mlist = [mn for mn in mlist if machine_family.get(mn, '') in active]
        mstr  = ', '.join(mlist) if mlist else 'all'
        soundhw.append({'name': name, 'desc': desc, 'machines': mstr, 'status': status})
    soundhw.sort(key=lambda s: s['name'])

    lines = ['// Auto-generated from data/soundhw/*.xml - do not edit\n']
    for s in soundhw:
        desc = _with_status(s['desc'], s['status']).replace('"', '\\"')
        lines.append(f'    {{ "{s["name"]}", "{desc}", "{s["machines"]}" }},\n')
    with open(os.path.join(gen_dir, 'soundhw.inc'), 'w', encoding='utf-8') as f:
        f.writelines(lines)

    # ── Parse character generator XMLs ───────────────────────────────────────
    cg_lines = {fam: ['// Auto-generated from data/chargen/*.xml - do not edit\n']
                for fam in active}
    for path in _xml_files('data/chargen/*.xml'):
        root = ET.parse(path).getroot()
        name = root.get('name')
        status = _status(path, root)
        desc = _with_status(root.get('description', ''), status).replace('"', '\\"')
        req  = root.get('requires', '')
        if req and req not in active:
            continue
        families = [req] if req else list(active)
        for fam in families:
            if fam in cg_lines:
                cg_lines[fam].append(f'    {{ "{name}", "{desc}" }},\n')
    for fam, flines in cg_lines.items():
        with open(os.path.join(gen_dir, f'chargens_{fam}.inc'), 'w', encoding='utf-8') as f:
            f.writelines(flines)

    # ── Parse VGA XMLs ────────────────────────────────────────────────────────
    # Generates one include per family: vgas_mos.inc, vgas_rca.inc, etc.
    vga_lines = {fam: ['// Auto-generated from data/vga/*.xml - do not edit\n']
                 for fam in active}
    for path in _xml_files('data/vga/*.xml'):
        root = ET.parse(path).getroot()
        name  = root.get('name')
        status = _status(path, root)
        desc  = _with_status(root.get('description', ''), status).replace('"', '\\"')
        req   = root.get('requires', '')
        if req not in active:
            continue
        vga_lines[req].append(f'    {{ "{name}", "{desc}" }},\n')
    for fam, flines in vga_lines.items():
        with open(os.path.join(gen_dir, f'vgas_{fam}.inc'), 'w', encoding='utf-8') as f:
            f.writelines(flines)

    return _xml_files('data/machine/**/*.xml', 'data/device/**/*.xml',
                      'data/soundhw/*.xml', 'data/chargen/*.xml',
                      'data/vga/*.xml', *TEST_DEVICE_TYPE_XML)

# ── Main ───────────────────────────────────────────────────────────────────────

def main():
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument('--help', '-h', action='store_true')
    p.add_argument('--target-list', default=','.join(FAMILY_SRC))
    p.add_argument('--enable-gtk',    dest='gtk',  action='store_true',  default=False)
    p.add_argument('--disable-gtk',   dest='gtk',  action='store_false')
    p.add_argument('--enable-sdl',    dest='sdl',  action='store_true',  default=True)
    p.add_argument('--disable-sdl',   dest='sdl',  action='store_false')
    p.add_argument('--enable-ttf',    dest='ttf',  action='store_true',  default=True)
    p.add_argument('--disable-ttf',   dest='ttf',  action='store_false')
    p.add_argument('--enable-crypto', dest='crypto', action='store_true',  default=True)
    p.add_argument('--disable-crypto',dest='crypto', action='store_false')
    p.add_argument('--static',        action='store_true', default=False)
    p.add_argument('--debug',         action='store_true', default=False)
    p.add_argument('--cc',            default=os.environ.get('CC', 'gcc'))
    p.add_argument('--extra-cflags',  default=os.environ.get('CFLAGS', ''))
    p.add_argument('--extra-ldflags', default=os.environ.get('LDFLAGS', ''))
    p.add_argument('--build-dir',     default='build')
    p.add_argument('--bindir',        default='bin')
    p.add_argument('--prefix',        default='/usr/local')
    p.add_argument('--cross',         default='')
    args = p.parse_args()

    if args.help:
        print(__doc__)
        sys.exit(0)

    targets = [t.strip() for t in args.target_list.split(',') if t.strip()]
    for t in targets:
        if t not in FAMILY_SRC:
            die(f'unknown family {t!r}. Valid: {", ".join(FAMILY_SRC)}')

    on_windows = sys.platform == 'win32'
    cross_windows = False
    if args.cross:
        global PKG_CONFIG
        if args.cc == 'gcc':
            args.cc = f'{args.cross}-gcc'
        if not shutil.which(args.cc):
            die(f'{args.cc} not found (cross compiler for --cross={args.cross})')
        if shutil.which(f'{args.cross}-pkg-config'):
            PKG_CONFIG = f'{args.cross}-pkg-config'
        elif not os.environ.get('PKG_CONFIG_LIBDIR'):
            # plain pkg-config would hand back the host's libraries
            die(f'--cross: no {args.cross}-pkg-config; set PKG_CONFIG_LIBDIR to the '
                'directory holding the target\'s .pc files')
        cross_windows = 'mingw' in args.cross
        on_windows = on_windows or cross_windows
    build_dir  = args.build_dir
    bin_dir    = args.bindir

    print(f'gemu configure')
    print(f'  families  : {", ".join(targets)}')
    print(f'  compiler  : {args.cc}')
    print()

    # ── Probe dependencies ────────────────────────────────────────────────────

    pkg_flags = ['--static'] if args.static else []

    sdl2_cflags = sdl2_libs = []
    if args.sdl:
        cf = pkg('sdl2', '--cflags', *pkg_flags)
        lf = pkg('sdl2', '--libs',   *pkg_flags)
        if not check('SDL2', cf):
            die('SDL2 not found - install libsdl2-dev')
        sdl2_cflags = cf
        sdl2_libs   = lf

    have_libzip  = False
    libzip_cflags = []
    libzip_libs   = []
    cf = pkg('libzip', '--cflags', *pkg_flags)
    lf = pkg('libzip', '--libs',   *pkg_flags)
    if check('libzip (-rom FILE.zip)', lf):
        have_libzip   = True
        libzip_cflags = cf or []
        libzip_libs   = lf or ['-lzip']
    else:
        print('  (libzip not found - -rom cannot point directly at a .zip)')

    have_slirp   = False
    slirp_cflags = []
    slirp_libs   = []
    cf = pkg('slirp', '--cflags', *pkg_flags)
    lf = pkg('slirp', '--libs',   *pkg_flags)
    if check('libslirp (-netdev user)', lf):
        have_slirp   = True
        slirp_cflags = cf or []
        slirp_libs   = lf or ['-lslirp']
    else:
        print('  (libslirp not found - no user-mode networking, -netdev user)')

    have_sdl_image  = False
    sdl_image_cflags = []
    sdl_image_libs   = []
    if args.sdl:
        cf = pkg('SDL2_image', '--cflags', *pkg_flags)
        lf = pkg('SDL2_image', '--libs',   *pkg_flags)
        if check('SDL2_image (window icon)', lf):
            have_sdl_image   = True
            sdl_image_cflags = cf or []
            sdl_image_libs   = lf
        else:
            print('  (SDL2_image not found - window icon disabled)')

    gtk_cflags = gtk_libs = []
    epoxy_cflags = epoxy_libs = []
    want_gtk = args.gtk
    if want_gtk:
        cf = pkg('gtk+-3.0', '--cflags', *pkg_flags)
        lf = pkg('gtk+-3.0', '--libs',   *pkg_flags)
        if not check('GTK 3', cf):
            print('  (GTK not found - building without GTK)')
            want_gtk = False
        else:
            gtk_cflags = cf
            gtk_libs   = lf
            ecf = pkg('epoxy', '--cflags', *pkg_flags)
            elf = pkg('epoxy', '--libs',   *pkg_flags)
            if check('epoxy (GL)', elf):
                epoxy_cflags = ecf or []
                epoxy_libs   = elf
            else:
                print('  (epoxy not found - building without GTK)')
                want_gtk = False

    have_ttf  = False
    ttf_cflags = []
    ttf_libs   = []
    if 'mos' in targets and args.sdl and args.ttf:
        cf = pkg('SDL2_ttf', '--cflags', *pkg_flags)
        lf = pkg('SDL2_ttf', '--libs',   *pkg_flags)
        if check('SDL2_ttf (VT100)', lf):
            have_ttf   = True
            ttf_cflags = cf or []
            ttf_libs   = lf
        else:
            print('  (SDL2_ttf not found - VT100 terminal will use host stdin/stdout)')

    have_alsa  = False
    alsa_cflags = []
    alsa_libs   = []
    if 'mos' in targets and not on_windows and not args.static:
        cf = pkg('alsa', '--cflags', *pkg_flags)
        lf = pkg('alsa', '--libs',   *pkg_flags)
        if check('ALSA (MIDI out)', lf):
            have_alsa   = True
            alsa_cflags = cf or []
            alsa_libs   = lf + ['-lm']

    have_winmidi = on_windows and 'mos' in targets
    if on_windows and 'mos' in targets:
        check('WinMM MIDI out', True)

    have_rob    = False
    assimp_libs = []
    gl_libs     = []
    if 'mos' in targets and not on_windows:
        lf = pkg('assimp', '--libs', *pkg_flags)
        gl = pkg('gl', '--libs', *pkg_flags)
        if check('assimp (ROB 3D window)', lf) and check('OpenGL (ROB 3D window)', gl):
            have_rob    = True
            assimp_libs = lf or ['-lassimp']
            gl_libs     = gl or ['-lGL']

    have_lua    = False
    lua_cflags  = []
    lua_libs    = []
    if 'mos' in targets:
        cf = pkg('lua5.1', '--cflags', *pkg_flags)
        lf = pkg('lua5.1', '--libs',   *pkg_flags)
        if check('Lua 5.1 (NES -lua scripting)', lf):
            have_lua   = True
            lua_cflags = cf or []
            lua_libs   = lf or ['-llua5.1']

    have_caca   = False
    caca_cflags = []
    caca_libs   = []
    if not on_windows:
        cf = pkg('caca', '--cflags', *pkg_flags)
        lf = pkg('caca', '--libs',   *pkg_flags)
        if check('libcaca', lf):
            have_caca   = True
            caca_cflags = cf or []
            caca_libs   = lf

    have_curses  = False
    curses_flags = []
    if not on_windows and not have_caca:
        cf = pkg('ncursesw', '--cflags', *pkg_flags)
        lf = pkg('ncursesw', '--libs',   *pkg_flags)
        if check('ncursesw', lf):
            have_curses  = True
            curses_flags = (cf or []) + lf
        else:
            if run([args.cc, '-lncursesw', '-x', 'c', '/dev/null', '-o', '/dev/null']) is not None:
                have_curses  = True
                curses_flags = ['-lncursesw']

    crypto_libs = []
    have_crypto = False
    if args.sdl and args.crypto:
        lf = pkg('libcrypto', '--libs', *pkg_flags)
        if check('OpenSSL libcrypto (VNC auth)', lf or ['-lcrypto']):
            crypto_libs = lf or ['-lcrypto']
            have_crypto = True
        else:
            die('OpenSSL libcrypto not found - install libssl-dev '
                'or pass --disable-crypto')

    print()

    # ── Build CFLAGS / LDFLAGS ────────────────────────────────────────────────

    opt_flag = '-O0 -g' if args.debug else '-O3 -flto'
    base_cflags = f'-Wall -Wextra {opt_flag} -std=gnu11 -pthread'
    if args.extra_cflags:
        base_cflags += ' ' + args.extra_cflags
    base_ldflags = '-pthread' + ('' if args.debug else ' -flto')
    if args.extra_ldflags:
        base_ldflags += ' ' + args.extra_ldflags

    orig_args = ' '.join(sys.argv[1:])

    # Generate .inc files from data/ XML files before writing build.ninja
    data_xml_files = generate_data(build_dir, targets, have_alsa, have_winmidi)

    # All sources share a single unified include path - no per-family separation.
    inc_dirs = ['core/include', 'core/third_party/cjson', 'cpu', 'jit', 'vga', 'audio', 'crt',
                'hardware', 'hardware/machine', 'hardware/device', 'window',
                'hardware/chip8', 'hardware/ia64', 'hardware/mos',
                'hardware/mos/nes', 'hardware/mos/a2600',
                'hardware/other', 'hardware/rca', 'hardware/x86', 'hardware/z80',
                'hardware/machine/chip8', 'hardware/machine/ia64',
                'hardware/machine/mos', 'hardware/machine/mos/nes',
                'hardware/machine/mos/a2600', 'hardware/machine/other',
                'hardware/machine/rca', 'hardware/machine/x86', 'hardware/machine/z80',
                'vga/ia64', 'vga/mos', 'vga/rca', 'vga/multi', 'vga/x86',
                'cpu/chip8', 'cpu/ia64', 'cpu/mos', 'cpu/other', 'cpu/rca', 'cpu/x86', 'cpu/z80',
                'src', 'compat/86box', 'compat/86box/include',
                'third_party/86box/v6.0/src/include', build_dir]
    inc_flags = ' '.join(f'-I{d}' for d in inc_dirs)

    defs_list = [f'HAVE_{t.upper()}' for t in targets]
    if want_gtk:   defs_list.append('GEMU_GTK')
    if on_windows: defs_list.append('GEMU_NO_CURSES')
    if have_ttf:   defs_list.append('HAVE_TTF')
    if have_alsa:    defs_list.append('HAVE_ALSA')
    if have_winmidi: defs_list.append('HAVE_WINMIDI')
    if have_rob:     defs_list.append('HAVE_ROB')
    if have_caca:    defs_list.append('HAVE_CACA')
    if have_lua:     defs_list.append('HAVE_LUA')
    if have_sdl_image: defs_list.append('HAVE_SDL_IMAGE')
    if have_libzip:    defs_list.append('HAVE_LIBZIP')
    if have_slirp:     defs_list.append('HAVE_SLIRP')
    if have_crypto:    defs_list.append('HAVE_CRYPTO')
    defs = ' '.join(f'-D{d}' for d in defs_list)

    cflags_parts = ['$CFLAGS_BASE', inc_flags] + sdl2_cflags
    if want_gtk:  cflags_parts += gtk_cflags + epoxy_cflags
    if have_caca: cflags_parts += caca_cflags
    if have_lua:  cflags_parts += lua_cflags
    if have_sdl_image: cflags_parts += sdl_image_cflags
    if have_libzip:    cflags_parts += libzip_cflags
    if have_slirp:     cflags_parts += slirp_cflags
    if defs:      cflags_parts.append(defs)
    unified_cflags = ' '.join(cflags_parts)

    ld_parts = [base_ldflags] + sdl2_libs + crypto_libs + ['-lm']
    if have_sdl_image: ld_parts += sdl_image_libs
    if have_libzip:    ld_parts += libzip_libs
    if have_slirp:     ld_parts += slirp_libs
    if want_gtk:  ld_parts += gtk_libs + epoxy_libs
    if have_caca: ld_parts += caca_libs
    elif have_curses: ld_parts += curses_flags
    if 'mos' in targets:
        if have_ttf:
            ld_parts += ttf_libs
        elif not on_windows:
            ld_parts += ['-lutil']
        if have_alsa:
            ld_parts += alsa_libs
        if have_rob:
            ld_parts += assimp_libs + gl_libs + ['-lepoxy', '-lm']
        if have_lua:
            ld_parts += lua_libs
    if on_windows:
        ld_parts += ['-lws2_32', '-mconsole']
        if have_winmidi:
            ld_parts += ['-lwinmm']
        if 'mos' in targets:
            # Native Win32 hex editor (window/hex_editor_win32.c): tab control
            # + SetWindowSubclass need comctl32, and the GDI text/bitmap
            # calls need gdi32 - neither is in MinGW's default link set
            # (user32, pulled in by the existing SDL File-menu code, is).
            ld_parts += ['-lcomctl32', '-lgdi32']
    ldflags = ' '.join(ld_parts)

    # ── Collect source files ──────────────────────────────────────────────────

    srcs = []
    seen = set()

    def add(src):
        if src not in seen:
            seen.add(src)
            srcs.append(src)

    for src in CORE_SRC:
        add(src)
    if have_caca:
        for src in CORE_SRC_CACA:
            add(src)
    if want_gtk:
        for src in CORE_SRC_GTK:
            add(src)

    for tname in targets:
        for src in FAMILY_SRC[tname]:
            add(src)
        if want_gtk:
            for src in FAMILY_SRC_GTK.get(tname, []):
                add(src)
        if have_alsa:
            for src in FAMILY_SRC_ALSA.get(tname, []):
                add(src)
        if have_winmidi:
            for src in FAMILY_SRC_WINMIDI.get(tname, []):
                add(src)
        if have_rob:
            for src in FAMILY_SRC_ROB.get(tname, []):
                add(src)
        if have_lua:
            for src in FAMILY_SRC_LUA.get(tname, []):
                add(src)

    add('src/main.c')

    # ── Write build.ninja ─────────────────────────────────────────────────────

    lines = [
        f'# Auto-generated by ./configure {orig_args}',
        f'# Do not edit - re-run ./configure to update.',
        f'',
        f'ninja_required_version = 1.3',
        f'',
        f'CC          = {args.cc}',
        f'CFLAGS_BASE = {base_cflags}',
        f'',
        '# Compile a C file; deps tracked via GCC depfile.',
        'rule cc',
        '  command = $CC $CFLAGS -MD -MF $out.d -c -o $out $in',
        '  depfile = $out.d',
        '  deps    = gcc',
        '  description = CC $in',
        '',
        '# Link object files into a binary.',
        'rule link',
        f'  command = $CC -o $out $in $LDFLAGS',
        '  description = LINK $out',
        '',
        '# Regenerate build.ninja when configure changes.',
        'rule reconfigure',
        f'  command = python3 configure {orig_args}',
        '  generator = 1',
        '  description = RECONFIGURE',
        '',
        f'build build.ninja: reconfigure configure {" ".join(data_xml_files)}',
        '',
    ]

    all_objs = []
    for src in srcs:
        obj = f'{build_dir}/{src[:-2]}.o'
        lines.append(f'build {obj}: cc {src}')
        lines.append(f'  CFLAGS = {unified_cflags}')
        all_objs.append(obj)
    # the device type registry: the types whose sources are linked
    dev_types = device_types(DEVICE_TYPE_XML)
    types_src = f'{build_dir}/generated/device_types.c'
    write_device_types(types_src, dev_types, set(srcs))
    lines.append(f'build {build_dir}/generated/device_types.o: cc {types_src}')
    lines.append(f'  CFLAGS = {unified_cflags}')
    all_objs.append(f'{build_dir}/generated/device_types.o')
    test_dev_types = device_types(DEVICE_TYPE_XML + TEST_DEVICE_TYPE_XML)

    lines.append('')
    # a Windows linker writes gemu.exe whatever it is told; name it so, or
    # ninja would relink every time (native MSYS2 builds keep the old name)
    binary = f'{bin_dir}/gemu.exe' if cross_windows else f'{bin_dir}/gemu'
    lines.append(f'build {binary}: link {" ".join(all_objs)}')
    lines.append(f'  LDFLAGS = {ldflags}')
    lines.append(f'build gemu: phony {binary}')
    for tname in targets:
        lines.append(f'build gemu-{tname}: phony {binary}')
    # SingleStepTests 8088 harness (not built by default): ninja x86-sst
    if 'cpu/x86/i8086.c' in srcs:
        sst_obj = f'{build_dir}/tests/x86_sst.o'
        lines.append(f'build {sst_obj}: cc tests/x86_sst.c')
        lines.append(f'  CFLAGS = {unified_cflags} -Icpu/x86 -Icore/third_party/cjson')
        lines.append(f'build {bin_dir}/x86-sst: link {sst_obj} '
                     f'{build_dir}/cpu/x86/i8086.o {build_dir}/core/third_party/cjson/cJSON.o')
        lines.append(f'  LDFLAGS = -lz')
        lines.append(f'build x86-sst: phony {bin_dir}/x86-sst')
    # SingleStepTests Z80 harness (not built by default): ninja z80-sst
    if 'cpu/z80/z80.c' in srcs:
        sst_obj = f'{build_dir}/tests/z80_sst.o'
        lines.append(f'build {sst_obj}: cc tests/z80_sst.c')
        lines.append(f'  CFLAGS = {unified_cflags} -Icpu/z80 -Icore/third_party/cjson')
        lines.append(f'build {bin_dir}/z80-sst: link {sst_obj} '
                     f'{build_dir}/cpu/z80/z80.o {build_dir}/core/third_party/cjson/cJSON.o')
        lines.append(f'  LDFLAGS = -lz')
        lines.append(f'build z80-sst: phony {bin_dir}/z80-sst')

    # Unit tests (see TESTS): ninja tests builds them, ninja check runs them
    # all, ninja check-NAME runs one.  The check edges have no output file, so
    # they always run.
    exe_suffix = '.exe' if cross_windows or on_windows else ''
    main_obj = f'{build_dir}/src/main.o'
    obj_of = {src: f'{build_dir}/{src[:-2]}.o' for src in srcs}
    features = {'sdl': args.sdl}
    # Windows builds compile with -Dmain=SDL_main; tests keep a plain main().
    test_cflags = ' -Umain -DSDL_MAIN_HANDLED' if '-Dmain=SDL_main' in unified_cflags else ''
    test_exes = []
    lines.append('')
    lines.append('# Run unit tests (tools/run_tests.py), output straight to the terminal.')
    lines.append('rule run_tests')
    lines.append(f'  command = python3 tools/run_tests.py --work {build_dir}/tests/run $in')
    lines.append('  description = CHECK')
    lines.append('  pool = console')
    for t in TESTS:
        if t['family'] is not None and t['family'] not in targets:
            continue
        if not all(features.get(n, False) for n in t.get('needs', [])):
            continue
        name = t['name']
        if t['kind'] == 'device':
            # A source that doesn't exist is a mistake in this table; one that
            # exists but isn't configured belongs to a family left out
            # (--target-list): the test just isn't built.
            absent = [s for s in t['links'] if not os.path.exists(s)]
            if absent:
                die(f'test {name}: {", ".join(absent)} not found')
            unconfigured = [s for s in t['links'] if s not in obj_of]
            if unconfigured:
                print(f'configure: test {name} skipped ({", ".join(unconfigured)} not configured)')
                continue
        test_obj = f'{build_dir}/tests/{name}.o'
        exe = f'{build_dir}/tests/{name}{exe_suffix}'
        lines.append(f'build {test_obj}: cc {t["src"]}')
        lines.append(f'  CFLAGS = {unified_cflags}{test_cflags} {t.get("cflags", "")}'.rstrip())
        if t['kind'] == 'device':
            objs = [test_obj] + [obj_of[s] for s in t['links']]
            if 'core/src/dev/device.c' in t['links']:
                # its own type registry: the types it links (and its own)
                reg_src = f'{build_dir}/tests/{name}_types.c'
                write_device_types(reg_src, test_dev_types, set(t['links']) | {t['src']})
                reg_obj = f'{build_dir}/tests/{name}_types.o'
                lines.append(f'build {reg_obj}: cc {reg_src}')
                lines.append(f'  CFLAGS = {unified_cflags}')
                objs.append(reg_obj)
        else:
            drop = {main_obj} | {obj_of[s] for s in t.get('replaces', [])}
            objs = [test_obj] + [o for o in all_objs if o not in drop]
        lines.append(f'build {exe}: link {" ".join(objs)}')
        lines.append(f'  LDFLAGS = {ldflags}')
        lines.append(f'build test-{name}: phony {exe}')
        lines.append(f'build check-{name}: run_tests {exe}')
        test_exes.append(exe)
    lines.append(f'build tests: phony {" ".join(test_exes)}')
    lines.append(f'build check: run_tests {" ".join(test_exes)}')
    lines.append('')
    lines.append(f'default {binary}')
    lines.append('')

    os.makedirs(bin_dir, exist_ok=True)

    with open('build.ninja', 'w', encoding='utf-8') as f:
        f.write('\n'.join(lines))

    # Symlinks for backward compat: gemu-chip8, gemu-mos, gemu-rca → gemu
    if not on_windows:
        for tname in targets:
            alias = os.path.join(bin_dir, f'gemu-{tname}')
            if os.path.islink(alias):
                os.unlink(alias)
            elif os.path.exists(alias):
                print(f'  warning: {alias} exists and is not a symlink; skipping')
                continue
            os.symlink('gemu', alias)

    # ── Summary ───────────────────────────────────────────────────────────────

    print('Configuration:')
    print(f'  binary    : {binary}')
    print(f'  families  : {", ".join(targets)}')
    print(f'  SDL2      : {"yes" if args.sdl else "no"}')
    print(f'  Window icon: {"yes (SDL2_image)" if have_sdl_image else "no"}')
    print(f'  -rom *.zip  : {"yes (libzip)" if have_libzip else "no"}')
    print(f'  -netdev user: {"yes (libslirp)" if have_slirp else "no"}')
    print(f'  GTK 3     : {"yes" if want_gtk else "no"}')
    print(f'  libcaca   : {"yes (enhanced terminal)" if have_caca else "no"}')
    print(f'  ncursesw  : {"yes" if have_curses else ("n/a (libcaca used)" if have_caca else "no")}')
    if 'mos' in targets:
        if have_winmidi:
            print( '  MIDI out  : yes (WinMM)')
        else:
            print(f'  ALSA MIDI : {"yes" if have_alsa else "no (MIDI output disabled)"}')
        print(f'  ROB 3D    : {"yes (assimp + OpenGL)" if have_rob else "no (assimp or OpenGL not found)"}')
        print(f'  Lua script: {"yes (-lua for NES)" if have_lua else "no (lua5.1 not found)"}')
    print(f'  debug     : {"yes (-O0 -g)" if args.debug else "no (-O3 -flto)"}')
    print(f'  build dir : {build_dir}/')
    print(f'  bin dir   : {bin_dir}/')
    print()
    print('Run "ninja" to build.')

if __name__ == '__main__':
    main()
