# ── Unit tests (ninja tests / ninja check) ────────────────────────────────────
# Each test builds to <build-dir>/tests/<name> and is run by tools/run_tests.py
# in a fresh temporary directory.  A test is configured when its family is in
# --target-list (family None: always).  Two kinds:
#   'device'  - the test plus `links`: the configured objects of those sources
#               only, no machine or CPU (catches accidental dependencies)
#   'program' - the whole emulator, minus the objects of the sources in
#               `replaces` (main.c always; a machine the test #includes)
# `cflags` is added to the configured flags; `needs` lists features
# (currently 'sdl') the test cannot build without.
I460GX_TEST_LINKS = [
    'hardware/device/chipset/i460gx.c', 'hardware/device/chipset/i460gx_fwh.c',
    'hardware/device/chipset/i460gx_pci.c', 'hardware/device/chipset/i460gx_pm.c',
    'hardware/device/chipset/i460gx_smbus.c', 'hardware/device/i2c/at24.c',
    'hardware/device/i2c/i2c.c', 'hardware/device/i2c/itanium_cart.c',
    'hardware/device/i2c/lm87.c', 'hardware/device/storage/fwh82802.c',
]
