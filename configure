#!/usr/bin/env python3
"""
gemu configure — probes dependencies and writes build.ninja.

Usage:
  ./configure [options]
  ninja            # build everything

Options:
  --target-list=LIST   comma-separated families to include (default: all)
                       valid families: chip8, mos, rca
  --enable-gtk         build GTK3 UI (default: no)
  --disable-sdl        do not link SDL2 (rarely useful)
  --disable-ttf        skip SDL2_ttf; VT100 terminal uses host stdin/stdout
  --cc=CC              C compiler (default: gcc)
  --extra-cflags=F     append extra compiler flags
  --extra-ldflags=F    append extra linker flags
  --debug              build with -O0 -g instead of -O2
  --build-dir=DIR      object directory (default: build)
  --bindir=DIR         binary output directory (default: bin)
  --prefix=DIR         install prefix (default: /usr/local)
"""

import sys, os, argparse, subprocess, shutil, glob
import xml.etree.ElementTree as ET

# ── Source file lists per family ───────────────────────────────────────────────

CORE_SRC = [
    'core/src/memory.c', 'core/src/tcg.c', 'core/src/monitor.c',
    'core/src/vnc.c', 'core/src/video_sdl.c', 'core/src/args.c',
    'core/src/sha256.c', 'core/src/screendump.c',
    'core/src/gemu_display.c', 'core/src/gemu_display_sdl.c',
]

CORE_SRC_CACA = ['core/src/gemu_display_caca.c']

CORE_SRC_GTK = [
    'core/src/gemu_display_gtk.c',
    'core/src/gtk_menu.c', 'core/src/video_gtk.c',
]

FAMILY_SRC = {
    'chip8': [
        'cpu/chip8_cpu.c', 'cpu/octo.c',
        'hardware/machine/machine_chip8.c',
        'vga/input_menu.c',
        'src/chip8_setup.c',
    ],
    'mos': [
        'cpu/mos6502.c',
        'vga/rp2c02.c', 'vga/input_menu.c',
        'audio/apu2a03.c',
        'hardware/machine/machine_mos.c', 'hardware/machine/machine_apple1.c',
        'hardware/machine/machine_nes.c', 'hardware/machine/machine_kim1.c',
        'hardware/device/fds.c', 'hardware/device/fds_hle.c',
        'hardware/device/vt100.c', 'hardware/romdb.c',
        'src/mos_setup.c',
    ],
    'rca': [
        'cpu/cdp1802.c',
        'vga/cdp1861.c', 'vga/cdp1869.c', 'vga/input_menu.c',
        'audio/pcspk.c',
        'hardware/machine/machine_vip.c', 'hardware/machine/machine_destroyer.c',
        'hardware/machine/machine_studio2.c', 'hardware/machine/machine_pecom.c',
        'hardware/device/rca_keyboard.c', 'hardware/device/tape.c', 'hardware/romdb.c',
        'src/rca_setup.c',
    ],
}

FAMILY_SRC_GTK = {
    'mos': ['vga/hex_editor.c'],
}

FAMILY_SRC_ALSA = {
    'mos': ['audio/midi_out.c', 'audio/apu_midi.c'],
}

FAMILY_SRC_WINMIDI = {
    'mos': ['audio/midi_out_winmm.c', 'audio/apu_midi.c'],
}

FAMILY_SRC_ROB = {
    'mos': ['hardware/device/rob.c', 'hardware/device/rob_window.c'],
}

FAMILY_SRC_LUA = {
    'mos': ['hardware/device/nes_lua.c'],
}

# ── Helpers ────────────────────────────────────────────────────────────────────

def run(cmd):
    try:
        return subprocess.check_output(cmd, stderr=subprocess.DEVNULL, text=True).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None

def pkg(package, *flags):
    r = run(['pkg-config'] + list(flags) + [package])
    return r.split() if r is not None else None

def check(label, result):
    print(f'  checking {label}... {"yes" if result else "no"}')
    return result

def die(msg):
    print(f'configure: error: {msg}', file=sys.stderr)
    sys.exit(1)

# ── Data-file generation ───────────────────────────────────────────────────────

FAMILY_SETUP  = {'mos': 'mos_setup', 'rca': 'rca_setup', 'chip8': 'chip8_setup'}
FAMILY_DEFINE = {'mos': 'HAVE_MOS',  'rca': 'HAVE_RCA',  'chip8': 'HAVE_CHIP8'}

def _xml_files(*patterns):
    paths = []
    for pat in patterns:
        paths.extend(sorted(glob.glob(pat)))
    return paths

def generate_data(build_dir, targets, have_alsa, have_winmidi=False):
    gen_dir = os.path.join(build_dir, 'generated')
    os.makedirs(gen_dir, exist_ok=True)

    active = set(targets)

    # ── Parse machine XMLs ────────────────────────────────────────────────────
    machines = []
    machine_family = {}
    for path in _xml_files('data/machine/*.xml'):
        root = ET.parse(path).getroot()
        name   = root.get('name')
        family = root.get('family')
        desc   = root.get('description', '')
        roms   = [{'name': r.get('name'), 'region': r.get('region', ''),
                   'addr': int(r.get('addr', '0'), 16),
                   'sha256': r.get('sha256', '')}
                  for r in root.findall('rom')]
        devices = [d.get('name') for d in root.findall('device') if d.get('name')]
        machines.append({
            'name':   name,
            'family': family,
            'desc':   desc,
            'roms':   roms,
            'alias':  root.get('alias',  ''),
            'cpu':    root.get('cpu',    ''),
            'vga':    root.get('vga',    ''),
            'soundhw': root.get('soundhw', ''),
            'chargen': root.get('chargen', ''),
            'tv':     root.get('tv',     ''),
            'ram':    root.get('ram',    ''),
            'devices': ','.join(devices),
        })
        machine_family[name] = family
    machines.sort(key=lambda m: m['name'])

    # Resolve alias inheritance: aliases inherit cpu/vga/soundhw/chargen from their canonical
    # (but not tv — that is machine-specific) and fill in canonical name.
    name_to_m = {m['name']: m for m in machines}
    for m in machines:
        if m['alias']:
            canon = name_to_m.get(m['alias'], {})
            if not m['cpu'] and canon.get('cpu'): m['cpu'] = canon['cpu']
            if not m['vga'] and canon.get('vga'): m['vga'] = canon['vga']
            if not m['soundhw'] and canon.get('soundhw'): m['soundhw'] = canon['soundhw']
            if not m['chargen'] and canon.get('chargen'): m['chargen'] = canon['chargen']
            m['canonical'] = m['alias']
        else:
            m['canonical'] = m['name']

    # machines.inc — filtered to active families, no #ifdef needed
    lines = ['// Auto-generated from data/machine/*.xml — do not edit\n']
    for m in machines:
        if m['family'] not in active:
            continue
        setup = FAMILY_SETUP.get(m['family'], m['family'] + '_setup')
        lines.append(f'    {{ "{m["name"]}", {setup}, "{m["desc"]}" }},\n')
    with open(os.path.join(gen_dir, 'machines.inc'), 'w', encoding='utf-8') as f:
        f.writelines(lines)

    # machine_defaults.inc — per-machine defaults table used by *_setup.c
    def cstr(s): return f'"{s}"' if s else 'NULL'
    dlines = ['// Auto-generated from data/machine/*.xml — do not edit\n']
    for m in machines:
        if m['family'] not in active:
            continue
        tv = m['tv'] or ('pal' if m.get('alias') and name_to_m.get(m['alias'], {}).get('tv') == 'pal' else 'ntsc')
        dlines.append(
            f'    {{ "{m["name"]}", "{m["canonical"]}", '
            f'{cstr(m["cpu"])}, {cstr(m["vga"])}, '
            f'{cstr(m["soundhw"])}, {cstr(m["chargen"])}, '
            f'"{tv}", {cstr(m["ram"])}, {cstr(m["devices"])} }},\n'
        )
    with open(os.path.join(gen_dir, 'machine_defaults.inc'), 'w', encoding='utf-8') as f:
        f.writelines(dlines)

    # romdb.inc — all families combined; romdb.c is family-agnostic
    romdb_lines = ['// Auto-generated from data/machine/*.xml — do not edit\n']
    for m in machines:
        for r in m['roms']:
            if not r['sha256']:
                continue
            romdb_lines.append(
                f'    {{ "{r["sha256"]}", 0x{r["addr"]:04X}u, '
                f'{cstr(r["region"])}, "{m["name"]}", "{r["name"]}" }},\n'
            )
    with open(os.path.join(gen_dir, 'romdb.inc'), 'w', encoding='utf-8') as f:
        f.writelines(romdb_lines)

    # ── Parse device XMLs ─────────────────────────────────────────────────────
    devices = []
    for path in _xml_files('data/device/*.xml'):
        root = ET.parse(path).getroot()
        name  = root.get('name')
        desc  = root.get('description', '')
        mlist = [m.get('name') for m in root.findall('machine')]
        mlist = [mn for mn in mlist if machine_family.get(mn, '') in active]
        if not mlist:
            continue
        devices.append({'name': name, 'desc': desc, 'machines': mlist})
    devices.sort(key=lambda d: d['name'])

    lines = ['// Auto-generated from data/device/*.xml — do not edit\n']
    for d in devices:
        desc = d['desc'].replace('"', '\\"')
        mstr = ', '.join(d['machines'])
        lines.append(f'    {{ "{d["name"]}", "{desc}", "{mstr}" }},\n')
    with open(os.path.join(gen_dir, 'devices.inc'), 'w', encoding='utf-8') as f:
        f.writelines(lines)

    # ── Parse soundhw XMLs ────────────────────────────────────────────────────
    soundhw = []
    for path in _xml_files('data/soundhw/*.xml'):
        root = ET.parse(path).getroot()
        name   = root.get('name')
        desc   = root.get('description', '')
        req    = root.get('requires', '')
        req_ft = root.get('requires-feature', '')
        mlist  = [m.get('name') for m in root.findall('machine')]
        if req and req not in active:
            continue
        if req_ft == 'alsa'  and not have_alsa:    continue
        if req_ft == 'midi'  and not (have_alsa or have_winmidi): continue
        mlist = [mn for mn in mlist if machine_family.get(mn, '') in active]
        mstr  = ', '.join(mlist) if mlist else 'all'
        soundhw.append({'name': name, 'desc': desc, 'machines': mstr})
    soundhw.sort(key=lambda s: s['name'])

    lines = ['// Auto-generated from data/soundhw/*.xml — do not edit\n']
    for s in soundhw:
        desc = s['desc'].replace('"', '\\"')
        lines.append(f'    {{ "{s["name"]}", "{desc}", "{s["machines"]}" }},\n')
    with open(os.path.join(gen_dir, 'soundhw.inc'), 'w', encoding='utf-8') as f:
        f.writelines(lines)

    # ── Parse character generator XMLs ───────────────────────────────────────
    cg_lines = {fam: ['// Auto-generated from data/chargen/*.xml — do not edit\n']
                for fam in active}
    for path in _xml_files('data/chargen/*.xml'):
        root = ET.parse(path).getroot()
        name = root.get('name')
        desc = root.get('description', '').replace('"', '\\"')
        req  = root.get('requires', '')
        if req and req not in active:
            continue
        families = [req] if req else list(active)
        for fam in families:
            if fam in cg_lines:
                cg_lines[fam].append(f'    {{ "{name}", "{desc}" }},\n')
    for fam, flines in cg_lines.items():
        with open(os.path.join(gen_dir, f'chargens_{fam}.inc'), 'w', encoding='utf-8') as f:
            f.writelines(flines)

    # ── Parse VGA XMLs ────────────────────────────────────────────────────────
    # Generates one include per family: vgas_mos.inc, vgas_rca.inc, etc.
    vga_lines = {fam: ['// Auto-generated from data/vga/*.xml — do not edit\n']
                 for fam in active}
    for path in _xml_files('data/vga/*.xml'):
        root = ET.parse(path).getroot()
        name  = root.get('name')
        desc  = root.get('description', '').replace('"', '\\"')
        req   = root.get('requires', '')
        if req not in active:
            continue
        vga_lines[req].append(f'    {{ "{name}", "{desc}" }},\n')
    for fam, flines in vga_lines.items():
        with open(os.path.join(gen_dir, f'vgas_{fam}.inc'), 'w', encoding='utf-8') as f:
            f.writelines(flines)

    return _xml_files('data/machine/*.xml', 'data/device/*.xml',
                      'data/soundhw/*.xml', 'data/chargen/*.xml',
                      'data/vga/*.xml')

# ── Main ───────────────────────────────────────────────────────────────────────

def main():
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument('--help', '-h', action='store_true')
    p.add_argument('--target-list', default=','.join(FAMILY_SRC))
    p.add_argument('--enable-gtk',    dest='gtk',  action='store_true',  default=False)
    p.add_argument('--disable-gtk',   dest='gtk',  action='store_false')
    p.add_argument('--enable-sdl',    dest='sdl',  action='store_true',  default=True)
    p.add_argument('--disable-sdl',   dest='sdl',  action='store_false')
    p.add_argument('--enable-ttf',    dest='ttf',  action='store_true',  default=True)
    p.add_argument('--disable-ttf',   dest='ttf',  action='store_false')
    p.add_argument('--static',        action='store_true', default=False)
    p.add_argument('--debug',         action='store_true', default=False)
    p.add_argument('--cc',            default=os.environ.get('CC', 'gcc'))
    p.add_argument('--extra-cflags',  default=os.environ.get('CFLAGS', ''))
    p.add_argument('--extra-ldflags', default=os.environ.get('LDFLAGS', ''))
    p.add_argument('--build-dir',     default='build')
    p.add_argument('--bindir',        default='bin')
    p.add_argument('--prefix',        default='/usr/local')
    args = p.parse_args()

    if args.help:
        print(__doc__)
        sys.exit(0)

    targets = [t.strip() for t in args.target_list.split(',') if t.strip()]
    for t in targets:
        if t not in FAMILY_SRC:
            die(f'unknown family {t!r}. Valid: {", ".join(FAMILY_SRC)}')

    on_windows = sys.platform == 'win32'
    build_dir  = args.build_dir
    bin_dir    = args.bindir

    print(f'gemu configure')
    print(f'  families  : {", ".join(targets)}')
    print(f'  compiler  : {args.cc}')
    print()

    # ── Probe dependencies ────────────────────────────────────────────────────

    pkg_flags = ['--static'] if args.static else []

    sdl2_cflags = sdl2_libs = []
    if args.sdl:
        cf = pkg('sdl2', '--cflags', *pkg_flags)
        lf = pkg('sdl2', '--libs',   *pkg_flags)
        if not check('SDL2', cf):
            die('SDL2 not found — install libsdl2-dev')
        sdl2_cflags = cf
        sdl2_libs   = lf

    gtk_cflags = gtk_libs = []
    epoxy_cflags = epoxy_libs = []
    want_gtk = args.gtk
    if want_gtk:
        cf = pkg('gtk+-3.0', '--cflags', *pkg_flags)
        lf = pkg('gtk+-3.0', '--libs',   *pkg_flags)
        if not check('GTK 3', cf):
            print('  (GTK not found — building without GTK)')
            want_gtk = False
        else:
            gtk_cflags = cf
            gtk_libs   = lf
            ecf = pkg('epoxy', '--cflags', *pkg_flags)
            elf = pkg('epoxy', '--libs',   *pkg_flags)
            if check('epoxy (GL)', elf):
                epoxy_cflags = ecf or []
                epoxy_libs   = elf
            else:
                print('  (epoxy not found — building without GTK)')
                want_gtk = False

    have_ttf  = False
    ttf_cflags = []
    ttf_libs   = []
    if 'mos' in targets and args.sdl and args.ttf:
        cf = pkg('SDL2_ttf', '--cflags', *pkg_flags)
        lf = pkg('SDL2_ttf', '--libs',   *pkg_flags)
        if check('SDL2_ttf (VT100)', lf):
            have_ttf   = True
            ttf_cflags = cf or []
            ttf_libs   = lf
        else:
            print('  (SDL2_ttf not found — VT100 terminal will use host stdin/stdout)')

    have_alsa  = False
    alsa_cflags = []
    alsa_libs   = []
    if 'mos' in targets and not on_windows and not args.static:
        cf = pkg('alsa', '--cflags', *pkg_flags)
        lf = pkg('alsa', '--libs',   *pkg_flags)
        if check('ALSA (MIDI out)', lf):
            have_alsa   = True
            alsa_cflags = cf or []
            alsa_libs   = lf + ['-lm']

    have_winmidi = on_windows and 'mos' in targets
    if on_windows and 'mos' in targets:
        check('WinMM MIDI out', True)

    have_rob    = False
    assimp_libs = []
    gl_libs     = []
    if 'mos' in targets and not on_windows:
        lf = pkg('assimp', '--libs', *pkg_flags)
        gl = pkg('gl', '--libs', *pkg_flags)
        if check('assimp (ROB 3D window)', lf) and check('OpenGL (ROB 3D window)', gl):
            have_rob    = True
            assimp_libs = lf or ['-lassimp']
            gl_libs     = gl or ['-lGL']

    have_lua    = False
    lua_cflags  = []
    lua_libs    = []
    if 'mos' in targets:
        cf = pkg('lua5.1', '--cflags', *pkg_flags)
        lf = pkg('lua5.1', '--libs',   *pkg_flags)
        if check('Lua 5.1 (NES -lua scripting)', lf):
            have_lua   = True
            lua_cflags = cf or []
            lua_libs   = lf or ['-llua5.1']

    have_caca   = False
    caca_cflags = []
    caca_libs   = []
    if not on_windows:
        cf = pkg('caca', '--cflags', *pkg_flags)
        lf = pkg('caca', '--libs',   *pkg_flags)
        if check('libcaca', lf):
            have_caca   = True
            caca_cflags = cf or []
            caca_libs   = lf

    have_curses  = False
    curses_flags = []
    if not on_windows and not have_caca:
        cf = pkg('ncursesw', '--cflags', *pkg_flags)
        lf = pkg('ncursesw', '--libs',   *pkg_flags)
        if check('ncursesw', lf):
            have_curses  = True
            curses_flags = (cf or []) + lf
        else:
            if run([args.cc, '-lncursesw', '-x', 'c', '/dev/null', '-o', '/dev/null']) is not None:
                have_curses  = True
                curses_flags = ['-lncursesw']

    crypto_libs = []
    if args.sdl:
        lf = pkg('libcrypto', '--libs', *pkg_flags)
        if check('OpenSSL libcrypto (VNC auth)', lf or ['-lcrypto']):
            crypto_libs = lf or ['-lcrypto']
        else:
            die('OpenSSL libcrypto not found — install libssl-dev')

    print()

    # ── Build CFLAGS / LDFLAGS ────────────────────────────────────────────────

    opt_flag = '-O0 -g' if args.debug else '-O2'
    base_cflags = f'-Wall -Wextra {opt_flag} -std=c11 -pthread'
    if args.extra_cflags:
        base_cflags += ' ' + args.extra_cflags
    base_ldflags = '-pthread'
    if args.extra_ldflags:
        base_ldflags += ' ' + args.extra_ldflags

    orig_args = ' '.join(sys.argv[1:])

    # Generate .inc files from data/ XML files before writing build.ninja
    data_xml_files = generate_data(build_dir, targets, have_alsa, have_winmidi)

    # All sources share a single unified include path — no per-family separation.
    inc_dirs = ['core/include', 'cpu', 'vga', 'audio',
                'hardware', 'hardware/machine', 'hardware/device',
                'src', build_dir]
    inc_flags = ' '.join(f'-I{d}' for d in inc_dirs)

    defs_list = [f'HAVE_{t.upper()}' for t in targets]
    if want_gtk:   defs_list.append('GEMU_GTK')
    if on_windows: defs_list.append('GEMU_NO_CURSES')
    if have_ttf:   defs_list.append('HAVE_TTF')
    if have_alsa:    defs_list.append('HAVE_ALSA')
    if have_winmidi: defs_list.append('HAVE_WINMIDI')
    if have_rob:     defs_list.append('HAVE_ROB')
    if have_caca:    defs_list.append('HAVE_CACA')
    if have_lua:     defs_list.append('HAVE_LUA')
    defs = ' '.join(f'-D{d}' for d in defs_list)

    cflags_parts = ['$CFLAGS_BASE', inc_flags] + sdl2_cflags
    if want_gtk:  cflags_parts += gtk_cflags + epoxy_cflags
    if have_caca: cflags_parts += caca_cflags
    if have_lua:  cflags_parts += lua_cflags
    if defs:      cflags_parts.append(defs)
    unified_cflags = ' '.join(cflags_parts)

    ld_parts = [base_ldflags] + sdl2_libs + crypto_libs
    if want_gtk:  ld_parts += gtk_libs + epoxy_libs
    if have_caca: ld_parts += caca_libs
    elif have_curses: ld_parts += curses_flags
    if 'mos' in targets:
        if have_ttf:
            ld_parts += ttf_libs
        elif not on_windows:
            ld_parts += ['-lutil']
        if have_alsa:
            ld_parts += alsa_libs
        if have_rob:
            ld_parts += assimp_libs + gl_libs + ['-lepoxy', '-lm']
        if have_lua:
            ld_parts += lua_libs
    if on_windows:
        ld_parts += ['-lws2_32', '-mconsole']
        if have_winmidi:
            ld_parts += ['-lwinmm']
    ldflags = ' '.join(ld_parts)

    # ── Collect source files ──────────────────────────────────────────────────

    srcs = []
    seen = set()

    def add(src):
        if src not in seen:
            seen.add(src)
            srcs.append(src)

    for src in CORE_SRC:
        add(src)
    if have_caca:
        for src in CORE_SRC_CACA:
            add(src)
    if want_gtk:
        for src in CORE_SRC_GTK:
            add(src)

    for tname in targets:
        for src in FAMILY_SRC[tname]:
            add(src)
        if want_gtk:
            for src in FAMILY_SRC_GTK.get(tname, []):
                add(src)
        if have_alsa:
            for src in FAMILY_SRC_ALSA.get(tname, []):
                add(src)
        if have_winmidi:
            for src in FAMILY_SRC_WINMIDI.get(tname, []):
                add(src)
        if have_rob:
            for src in FAMILY_SRC_ROB.get(tname, []):
                add(src)
        if have_lua:
            for src in FAMILY_SRC_LUA.get(tname, []):
                add(src)

    add('src/main.c')

    # ── Write build.ninja ─────────────────────────────────────────────────────

    lines = [
        f'# Auto-generated by ./configure {orig_args}',
        f'# Do not edit — re-run ./configure to update.',
        f'',
        f'ninja_required_version = 1.3',
        f'',
        f'CC          = {args.cc}',
        f'CFLAGS_BASE = {base_cflags}',
        f'',
        '# Compile a C file; deps tracked via GCC depfile.',
        'rule cc',
        '  command = $CC $CFLAGS -MD -MF $out.d -c -o $out $in',
        '  depfile = $out.d',
        '  deps    = gcc',
        '  description = CC $in',
        '',
        '# Link object files into a binary.',
        'rule link',
        f'  command = $CC -o $out $in $LDFLAGS',
        '  description = LINK $out',
        '',
        '# Regenerate build.ninja when configure changes.',
        'rule reconfigure',
        f'  command = python3 configure {orig_args}',
        '  generator = 1',
        '  description = RECONFIGURE',
        '',
        f'build build.ninja: reconfigure configure {" ".join(data_xml_files)}',
        '',
    ]

    all_objs = []
    for src in srcs:
        obj = f'{build_dir}/{src[:-2]}.o'
        lines.append(f'build {obj}: cc {src}')
        lines.append(f'  CFLAGS = {unified_cflags}')
        all_objs.append(obj)

    lines.append('')
    binary = f'{bin_dir}/gemu'
    lines.append(f'build {binary}: link {" ".join(all_objs)}')
    lines.append(f'  LDFLAGS = {ldflags}')
    lines.append(f'build gemu: phony {binary}')
    for tname in targets:
        lines.append(f'build gemu-{tname}: phony {binary}')
    lines.append('')
    lines.append(f'default {binary}')
    lines.append('')

    os.makedirs(bin_dir, exist_ok=True)

    with open('build.ninja', 'w', encoding='utf-8') as f:
        f.write('\n'.join(lines))

    # Symlinks for backward compat: gemu-chip8, gemu-mos, gemu-rca → gemu
    if not on_windows:
        for tname in targets:
            alias = os.path.join(bin_dir, f'gemu-{tname}')
            if os.path.islink(alias):
                os.unlink(alias)
            elif os.path.exists(alias):
                print(f'  warning: {alias} exists and is not a symlink; skipping')
                continue
            os.symlink('gemu', alias)

    # ── Summary ───────────────────────────────────────────────────────────────

    print('Configuration:')
    print(f'  binary    : {binary}')
    print(f'  families  : {", ".join(targets)}')
    print(f'  SDL2      : {"yes" if args.sdl else "no"}')
    print(f'  GTK 3     : {"yes" if want_gtk else "no"}')
    print(f'  libcaca   : {"yes (enhanced terminal)" if have_caca else "no"}')
    print(f'  ncursesw  : {"yes" if have_curses else ("n/a (libcaca used)" if have_caca else "no")}')
    if 'mos' in targets:
        if have_winmidi:
            print( '  MIDI out  : yes (WinMM)')
        else:
            print(f'  ALSA MIDI : {"yes" if have_alsa else "no (MIDI output disabled)"}')
        print(f'  ROB 3D    : {"yes (assimp + OpenGL)" if have_rob else "no (assimp or OpenGL not found)"}')
        print(f'  Lua script: {"yes (-lua for NES)" if have_lua else "no (lua5.1 not found)"}')
    print(f'  debug     : {"yes (-O0 -g)" if args.debug else "no (-O2)"}')
    print(f'  build dir : {build_dir}/')
    print(f'  bin dir   : {bin_dir}/')
    print()
    print('Run "ninja" to build.')

if __name__ == '__main__':
    main()
